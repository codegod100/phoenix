{
  "name": "phoenix-vcs",
  "version": "0.2.0",
  "description": "Regenerative version control system — causal compiler for intent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vcs": {
      "import": "./dist/vcs/index.js",
      "types": "./dist/vcs/index.d.ts"
    }
  },
  "bin": {
    "phoenix": "dist/cli.js",
    "phoenix-vcs": "dist/vcs/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/vcs/index.ts ./src/vcs/cli.ts --outdir=dist/vcs --target=bun",
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "vcs": "bun dist/vcs/cli.js",
    "dev:vcs": "bun run src/vcs/cli.ts",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.64.0",
    "@mariozechner/pi-coding-agent": "^0.64.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
