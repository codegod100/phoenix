# Arc-Dark Theme
# Popular dark theme from Arc browser and various Linux distros
# https://github.com/NicoHood/arc-theme

{
  name = "arc-dark",
  type = "dark",

  # Background colors
  base = "#2f343f",
  mantle = "#262b33",
  crust = "#1e2227",

  # Surface colors
  surface0 = "#383c4a",
  surface1 = "#404552",
  surface2 = "#4b5162",

  # Text colors
  text = "#d3dae3",
  subtext1 = "#b6bcc8",
  subtext0 = "#9aa0ac",

  # Overlay colors
  overlay2 = "#7c818c",
  overlay1 = "#666b77",
  overlay0 = "#50555f",

  # Accent colors (Arc blue)
  blue = "#5294e2",
  sky = "#6aaaff",
  sapphire = "#81c1ff",

  # Other accents
  lavender = "#a8b5ff",
  pink = "#ff9ece",
  mauve = "#c5a3ff",
  red = "#e85d75",
  maroon = "#d47085",
  peach = "#ff9e80",
  yellow = "#ffdf80",
  green = "#85d175",
  teal = "#7ee0c5",
  flamingo = "#ffb8b8",
  rosewater = "#ffd6d6"
}
